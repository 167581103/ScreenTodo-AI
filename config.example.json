{
  "user": {
    "name": "你的名字(会替换 prompts/*.md 里的 {{USER}} 占位符)"
  },
  "deepseek": {
    "apiBase": "https://api.deepseek.com",
    "apiKey": "sk-YOUR_DEEPSEEK_API_KEY",
    "model": "deepseek-chat"
  },
  "screenpipe": {
    "apiBase": "http://localhost:3030",
    "searchLimit": 300
  },
  "sink": {
    "add": "node sinks/local-vault.js add",
    "find": "node sinks/local-vault.js find"
  },
  "monitor": {
    "intervalSec": 5,
    "todoFile": "captured_todos.md",
    "winFrames": 6,
    "winPerFrame": 900,
    "winMaxChars": 4500,
    "baselineFrames": 30
  },
  "filter": {
    "denyApps": ["聚焦", "终端"],
    "allowApps": [],
    "chromePatterns": ["WorkBuddy( v[\\d.]+)?"]
  },
  "appearance": {
    "theme": "auto"
  }
}
