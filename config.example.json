{
  "user": {
    "name": "你的名字(会替换 prompts/*.md 里的 {{USER}} 占位符)",
    "rules": [
      "个人判读偏好,逐条写,会替换 prompts 里的 {{USER_RULES}} 占位符",
      "例:我在 Obsidian/笔记应用里浏览时,屏幕内容一律不算派活",
      "例:xx 群里的消息不用管"
    ]
  },
  "deepseek": {
    "apiBase": "https://api.deepseek.com",
    "apiKey": "sk-YOUR_DEEPSEEK_API_KEY",
    "model": "deepseek-chat"
  },
  "screenpipe": {
    "apiBase": "http://localhost:3030",
    "searchLimit": 300
  },
  "sink": {
    "add": "node sinks/local-vault.js add",
    "find": "node sinks/local-vault.js find"
  },
  "monitor": {
    "intervalSec": 5,
    "todoFile": "captured_todos.md",
    "winFrames": 6,
    "winPerFrame": 900,
    "winMaxChars": 4500,
    "baselineFrames": 30,
    "sessionMaxChars": 60000,
    "compactRecent": 2
  },
  "filter": {
    "denyApps": [
      "聚焦",
      "终端"
    ],
    "allowApps": [],
    "chromePatterns": [
      "WorkBuddy( v[\\d.]+)?"
    ]
  },
  "appearance": {
    "theme": "auto"
  }
}